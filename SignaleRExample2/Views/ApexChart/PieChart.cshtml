@using Newtonsoft.Json
@using SignaleRExample2.Controllers
@model List<StudentModel>
@{
    List<int> series = Model.Select(s => s.Age).ToList();
    List<string> labels = Model.Select(s => s.Name).ToList();
}
<div id="chart-container">
    <div id="chart">
    </div>
</div>
@section scripts {
    <script>
        loadChart(
        @Html.Raw(JsonConvert.SerializeObject(series)),
        @Html.Raw(JsonConvert.SerializeObject(labels))
        );
        // var connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        // connection.on("UpdateChart", function (_series, _labels, _count) {
        // loadChart(_series, _labels);
        // $("#totalCount").text(_count);
        // });

        // connection.start().then(function () {
        // }).catch(function (err) {
        // return console.error(err.toString());
        // });

        function loadChart(_series, _labels) {
        $("#chart-container").html("<div id='chart'></div>");
        var options = {
        series: _series,
        chart: {
        width: 380,
        type: 'pie',
        },
        labels: _labels,
        responsive: [{
        breakpoint: 480,
        options: {
        chart: {
        width: 200,
        },
        legend: {
        position: 'bottom',
        },
        },
        }],
        };

        var chart = new ApexCharts(document.querySelector('#chart'), options);
        chart.render();
        }
    </script>
}