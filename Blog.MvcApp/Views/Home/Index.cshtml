@model List<CommentResponseModel>

@{
    ViewData["Title"] = "Home Page";
    // List<CommentResponseModel> comments = (List<CommentResponseModel>) ViewData["Comments"]!;
    List<CommentResponseModel> comments = ViewBag.Comments;
    string lastUpdated = TempData["LastUpdated"].ToString()!;
}

<h2>Comments</h2>
<h2>@lastUpdated</h2>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Comment Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @if (comments != null && comments.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CommentName</td>
                    <td>@item.CommentDescription</td>
                </tr>
            }
        }
    </tbody>
</table>
