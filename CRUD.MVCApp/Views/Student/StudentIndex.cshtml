@model List<WalletModel>
<h1>BlogIndex @Model.Count</h1>
@{
    int count = 0;
}

<table class="table table-responsive">

    <tr>
        <th>No.</th>
        <th>Roll No</th>
        <th>Name</th>
    </tr>

  <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.Roll_No</td>
                <td>@item.Name</td>
            </tr>
        }
    </tbody>

</table>