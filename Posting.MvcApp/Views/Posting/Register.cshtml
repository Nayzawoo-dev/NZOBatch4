@{
    ViewData["Title"] = "Create Page";
}
<form method="post" action="/Posting/Save">
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Email address</label>
        <input type="email" class="form-control" id="txtEmail" name="email" aria-describedby="emailHelp">
        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Password</label>
        <input type="password" class="form-control" name="password" id="txtPassword">
    </div>

    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Username</label>
        <input type="text" class="form-control" name="username" id="txtPassword">
    </div>

    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Roll-No</label>
        <input type="text" class="form-control" name="roll_no" id="txtRollNo">
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
