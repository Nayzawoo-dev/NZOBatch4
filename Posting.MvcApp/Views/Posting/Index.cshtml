@model List<ResponseUserModel>
@{
    ViewData["Title"] = $"{Model.Count}";
}

<h2 class="mb-4">User List</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var user in Model)
    {
        if (!user.IsSuccess)
        {
            <h1>@user.Message</h1>
        }
        else
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@user.username</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Roll No: @user.roll_no</h6>
                        <p class="card-text">
                            <strong>Email:</strong> @user.email
                        </p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">User Info Card</small>
                    </div>
                </div>
            </div>
        }
    }
</div>

