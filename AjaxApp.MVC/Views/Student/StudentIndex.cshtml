<h1>Studenet Count<span id="txtCount"></span></h1>

<a class="btn btn-outline-success" href="Student/Create">Add New Student</a>

<table class="table table-responsive">

    <tr>
        <th></th>
        <th>Roll No</th>
        <th>Name</th>
    </tr>

    <tbody id="tbDataTable">
    </tbody>

</table>

@section scripts {
    <script>
        loadData();
         function loadData(){
              $.ajax({
            url: '/Student/Index',
            type: 'Post',

            success: function(response) {
               for(let i = 0; i < response.Data.length; i++){
                   let item = response.Data[i];
                   let row = `
                   <tr>
                <td>
                    <a href="/Student/Edit/${item.Id}" class="btn btn-outline-success">Edit</a>
                    <a href="/Student/Delete/${item.Id}" class="btn btn-outline-danger">Delete</a>
                </td>

                <td>${item.Roll_No}</td>
                <td>${item.Name}</td>
            </tr>
                   `;
                   $('#tbDataTable').append(row);
               }
            },
            error: function(requests, status, error) {
                console.error('Error:', error);
            }
        });
         }
    </script>
}
