<h1>Studenet Count<span id="txtCount"></span></h1>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
  Add New Student
</button>

<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="studentModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="studentModalLabel">Add New Student</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <partial name="~/Views/Student/StudentCreate.cshtml" />
      </div>
    </div>
  </div>
</div>

<table class="table table-responsive">

    <tr>
        <th></th>
        <th>Roll No</th>
        <th>Name</th>
    </tr>

    <tbody id="tbDataTable">
    </tbody>

</table>

@section scripts {
  <script src="~/js/Student/studentCreate.js" ></script>
}
